# Build output
/ansible-bom
/dist/
/bin/
*.exe
*.dll
*.so
*.dylib

# Test and coverage artifacts
*.test
*.out
coverage.*

# Go workspace files (per-developer, not shared)
go.work
go.work.sum

# Generated BOM / scan output — regenerate, don't commit.
# Test fixtures under testdata/ are deliberately NOT ignored.
/*.cdx.json
/*.spdx.json
/sbom/

# Private/local context — never track (also git-excluded)
CLAUDE.local.md
**/CLAUDE.local.md

# Secrets and credentials
.env
.env.*
!.env.example
.envrc
.envrc.local
*.pem
*.key
credentials.json
secrets.yaml

# OS / editor noise
.DS_Store
*.swp
*~
.cache/
