root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
indent_style = space

[*.go]
indent_style = tab
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

[*.md]
max_line_length = 100

# Captured from real content trees — must stay byte-identical to what was on disk,
# or the parser tests stop testing reality.
[testdata/**]
trim_trailing_whitespace = false
insert_final_newline = false
